<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      Margin="8">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="240"/>
    </Grid.RowDefinitions>

    <!-- ====================  TOOLBAR  ==================== -->
    <Border Grid.Row="0" Padding="8,6,8,8"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8*" MinWidth="60" MaxWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Style="{DynamicResource FieldLabelStyle}" Grid.Column="0" Text="Filter:"   VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Column="1" x:Name="txtFilter"
                       ToolTip="Match text in DisplayName, Publisher and DisplayVersion."/>

            <TextBlock Style="{DynamicResource FieldLabelStyle}" Grid.Column="3" Text="Scope:"    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox  ItemContainerStyle="{DynamicResource ThemedComboBoxItemStyle}" Grid.Column="4" x:Name="cboScope" SelectedIndex="0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Machine (HKLM)"/>
                <ComboBoxItem Content="User (HKCU)"/>
            </ComboBox>

            <Button Grid.Column="6" x:Name="btnRefresh"           Content="Refresh"           Style="{DynamicResource SquareInlineButtonStyle}" ToolTip="Read the ARP entries again."/>
            <Button Grid.Column="7" x:Name="btnUseForDetection"   Content="Use for Detection" Style="{DynamicResource PrimaryButtonStyle}" Visibility="Collapsed" ToolTip="Fill a registry value clause from the selected entry."/>
            <Button Grid.Column="8" x:Name="btnCopyDetails"       Content="Copy Details"      Style="{DynamicResource SquareInlineButtonStyle}" Visibility="Collapsed" ToolTip="Copy the fields of the selected entry to the clipboard."/>
        </Grid>
    </Border>

    <!-- ====================  GRID  ==================== -->
    <DataGrid Grid.Row="1" x:Name="dgApps"
              Margin="0,8,0,0"
              Style="{DynamicResource HistoryGridStyle}"
              CellStyle="{DynamicResource GridCellStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="DisplayName"    Binding="{Binding DisplayName}"    Width="*"/>
            <DataGridTextColumn Header="Publisher"      Binding="{Binding Publisher}"      Width="200"/>
            <DataGridTextColumn Header="DisplayVersion" Binding="{Binding DisplayVersion}" Width="140"/>
            <DataGridTextColumn Header="Architecture"   Binding="{Binding Architecture}"   Width="120"/>
            <DataGridTextColumn Header="Scope"          Binding="{Binding Scope}"          Width="90"/>
        </DataGrid.Columns>
    </DataGrid>

    <!-- ====================  DIVIDER  ==================== -->
    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                  Background="{DynamicResource MahApps.Brushes.Gray8}"
                  ResizeDirection="Rows"/>

    <!-- ====================  DETAIL PANEL  ==================== -->
    <Border Grid.Row="3" Padding="12" Margin="0,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="detailPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="DisplayName:"          Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="dtlDisplayName"      FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher:"            Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="dtlPublisher"        FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="DisplayVersion:"       Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="dtlDisplayVersion"   FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture and Scope:" Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="dtlArchScope"        FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="RegistryKey:"          Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="dtlRegistryKey"      FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="UninstallString:"      Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="dtlUninstallString"  FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="QuietUninstallString:" Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="dtlQuietUninstall"   FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="InstallLocation:"      Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="dtlInstallLocation"  FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="InstallDate:"          Style="{DynamicResource FieldLabelStyle}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="dtlInstallDate"      FontFamily="Cascadia Code, Consolas, Courier New" Margin="0,2"/>
            </Grid>
        </ScrollViewer>
    </Border>
</Grid>
