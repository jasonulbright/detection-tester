<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Detection Tester"
    Width="1100" Height="750"
    MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The module pages (Modules\*.xaml) are loaded into the content host of this window. They name the styles
                 below with DynamicResource, so every style of the app is defined here once.

                 Contrast overrides of the MahApps theme brushes. One value passes in both themes:
                 #7F7F7F is 4.0:1 on white and 3.8:1 on #252525 (control borders need 3:1);
                 white title text is 7.0:1 on #595959 (the inactive title bar). -->
            <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7F7F7F"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#595959"/>

            <!-- The one button template and the one button style. Every Button of the window takes ThemedButtonStyle
                 or a style that is based on it. No color literal is allowed here: the colors come from the MahApps
                 theme resources, so the same markup works in the dark and the light theme. Hover shows the theme foreground as border color.
                 Pressed swaps the theme foreground and the theme background. A disabled button shows MahApps.Brushes.Gray.MouseOver text (4.5:1 or more in both
                 themes) and a Gray2 border, because the MahApps disabled state fades the text below 4.5:1. -->
            <ControlTemplate x:Key="ThemedButtonTemplate" TargetType="Button">
                <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Name="Cp"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ThemedButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">

                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Setter Property="Template" Value="{StaticResource ThemedButtonTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Check box and radio button text keeps 4.5:1 when disabled. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Controls:CheckBoxHelper.ForegroundUncheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundCheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundIndeterminateDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
                <Setter Property="Controls:RadioButtonHelper.ForegroundDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>

            <!-- Selected and highlighted items: white text (IdealForeground) on the theme highlight, in both themes. -->
            <Style x:Key="ThemedListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                <!-- Disabled item text keeps 4.5:1. The MahApps grey is 3.7:1 dark and 1.9:1 light. -->
                <Setter Property="Controls:ItemHelper.DisabledForegroundBrush" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The sidebar buttons. SuiteCommon sets their colors for the theme (Update-SidebarButtonTheme). -->
            <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="8,3,8,3"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}"/>

            <Style x:Key="SquareInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="Margin" Value="4,0,4,0"/>
            </Style>

            <!-- The one primary button style: the theme highlight (#4A5763 dark, #00589F light) with white text, 7:1 on both.
                 The border is the theme foreground, because the highlight alone is 2.1:1 on the dark window. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="Margin" Value="4,0,4,0"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The two data grids. A selected row and a selected cell show white text (IdealForeground) on the theme highlight. -->
            <Style x:Key="HistoryGridRow" TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Column headers keep the case of their text (Title Case). MahApps makes them upper case by default. -->
            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>

            <Style x:Key="HistoryGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ColumnHeaderHeight" Value="30"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource HistoryGridRow}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeaderStyle}"/>
            </Style>

            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Field titles and section titles are bold, the same in both themes. The value next to a title keeps the normal body style. -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- The key of a key and value list. The value is text and not an input, so the key keeps the SemiBold weight. -->
            <Style x:Key="KeyLabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}"/>
                <Setter Property="Margin" Value="12,14,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,0">
                    <TextBlock x:Name="txtAppTitle" Text="Detection Tester" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtAppVersion" Text="" FontSize="10"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Switch between the dark theme and the light theme."/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Workflow" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button x:Name="btnDetection" Content="Detection Tester"       Style="{StaticResource ViewButtonStyle}"    ToolTip="Author and test detection clauses."/>
                        <Button x:Name="btnInstalled" Content="Installed Applications" Style="{StaticResource ViewButtonStyle}"    ToolTip="Browse the Add or Remove Programs entries of both registry hives."/>

                        <TextBlock Text="Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button x:Name="btnOptions"   Content="Options"                Style="{StaticResource OptionsButtonStyle}" ToolTip="Open the Options dialog."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Sidebar / content separator -->
        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Module header -->
            <Border Grid.Row="0" Padding="16,12,16,10"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle" Text="Detection Tester" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModuleSubtitle" Text="Author and test Configuration Manager detection methods locally."
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Module content host -->
            <ContentControl x:Name="contentHost" Grid.Row="1" Margin="8,8,8,0"/>

            <!-- Resizable splitter -->
            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <!-- Log output drawer -->
            <Border Grid.Row="3">
                <DockPanel>
                    <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Top" Text="Log Output"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="8,6,0,4"/>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="4" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready."/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>
